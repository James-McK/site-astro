---
import { Image } from "astro:assets";

import ico from "./ico.png";

const links = [
	{ to: "/blog", text: "Blog" },
	{ to: "/projects", text: "Projects" },
	{ to: "/uses", text: "Uses" },
];
---

<header>
	<a href="/" aria-label="Home"><Image src={ico} alt="" aria-hidden /></a>

	<nav>
		<ul>
			{
				links.map((link, index) => {
					return (
						<>
							<li>
								<span class="wawa" aria-hidden>
									{link.text}
								</span>
								<a href={link.to}>{link.text}</a>
							</li>
							{index !== links.length - 1 && (
								<span class="divider" aria-hidden>
									∗
								</span>
							)}
						</>
					);
				})
			}
		</ul>
	</nav>
</header>

<style is:global>
	header {
		max-width: 95ch;
		margin: 0 auto;
		margin-bottom: 1rem;

		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-left: 1.5rem;
		padding-right: 1.5rem;

		a:has(img),
		img {
			height: 2rem;
			width: auto;
			padding: 0;
			transition: transform 0.2s ease-out;
		}

		img:hover {
			transform: scale(1.1) rotate(3deg);
		}

		.wawa {
			color: transparent;
			position: absolute;

			font-weight: bold;
			pointer-events: none;
			user-select: none;

			height: 0.1em;
			background-color: var(--accent);
			transition:
				opacity 300ms,
				transform 300ms;
			transform: scaleX(0);
			transform-origin: right;

			&:has(+ a:hover) {
				transform: scale(1);
				transform-origin: left;
			}
		}

		a {
			text-decoration: none;
			font-weight: bold;
			color: transparent;

			transition: color 0.2s ease-out;
			padding: 0.1em 0;

			&:hover {
				color: var(--accent);
			}
		}
	}

	nav ul {
		list-style: none;
		display: flex;
		margin: 0;
		padding: 0;
		text-transform: lowercase;

		color: transparent;
		background: linear-gradient(to right, #edd0ee, #beabee);

		background-clip: text;

		li {
			display: flex;
			flex-direction: column-reverse;
		}

		.divider {
			margin: 0 0.3rem;
			font-weight: bold;
			color: var(--text);
			pointer-events: none;
			user-select: none;
			margin-top: 0.1rem;
			margin-bottom: -0.1rem;
		}
	}
</style>
